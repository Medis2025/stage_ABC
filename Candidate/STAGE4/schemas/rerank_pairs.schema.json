{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage4 rerank_pairs.jsonl row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sample_id",
    "source_evidence_id",
    "query",
    "span",
    "span_start",
    "span_end",
    "candidate_node_id",
    "candidate_name",
    "candidate_definition",
    "candidate_synonyms",
    "evidence_ids",
    "graph_features",
    "label",
    "negative_type",
    "reason",
    "confidence_tier",
    "split"
  ],
  "properties": {
    "sample_id": {"type": "string"},
    "source_evidence_id": {"type": "string"},
    "query": {"type": "string"},
    "span": {"type": "string"},
    "span_start": {"type": "integer", "minimum": 0},
    "span_end": {"type": "integer", "minimum": 0},
    "candidate_node_id": {"type": "string"},
    "candidate_name": {"type": "string"},
    "candidate_definition": {"type": "string"},
    "candidate_synonyms": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "graph_features": {"type": "object"},
    "label": {"enum": [0, 1]},
    "negative_type": {"type": ["string", "null"], "enum": ["retriever_top_k_wrong", "ontology_sibling_wrong", "ontology_parent_child_wrong", "embedding_close_wrong", "random_wrong", null]},
    "reason": {"type": "string"},
    "confidence_tier": {"enum": ["high", "medium", "weak"]},
    "split": {"enum": ["train", "dev", "test", "long_tail_eval"]}
  }
}
